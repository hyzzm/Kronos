#!/bin/bash
# ============================================================
#  Kronos WebUI 双击启动 (macOS)
#  在 Finder 里双击本文件即可启动服务并打开浏览器
# ============================================================

# 定位到本文件所在目录（双击时 Terminal 的当前目录是用户主目录）
cd "$(dirname "$0")" || exit 1

# 执行一键启动脚本
./start_webui.sh
STATUS=$?

# 启动失败时保持窗口打开，方便看到错误信息
if [ $STATUS -ne 0 ]; then
    echo ""
    echo "⚠️ 启动失败 (exit $STATUS)，按回车键关闭窗口..."
    read -r
fi
